<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Notification is the app's only passive warning channel (open-field reason + receipt). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- android:name=".App" IS requirement #1 of this project: installs the crash
         recorder before any screen. The other app's previous 4 builds died blind for
         not having this line. -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.4Form">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Profile-by-file entry point (brief 243). Exported=true ONLY for sharing:
             receiving ACTION_SEND from another app requires it. It returns no data at
             all, and nothing is saved without the person confirming on screen. -->
        <activity
            android:name=".ProfileFileActivity"
            android:exported="true"
            android:label="4Form · profile">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <!-- Telegram and file managers usually send .md as
                     application/octet-stream; without this line 4Form does not show up in
                     the share list. Narrower than "*/*" on purpose: we don't want the app
                     showing up on EVERY share. The code already reads via stream. -->
                <data android:mimeType="application/octet-stream" />
                <!-- Real resumes arrive as PDF (brief 254). Extraction is local, via
                     pdfbox-android; the file itself is never kept. -->
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ReceiptActivity"
            android:exported="false" />

        <activity
            android:name=".LearnedActivity"
            android:exported="false" />

        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false" />

        <!-- Serves ONLY the diagnostics, read-only, and only to the app chosen for
             sharing (URI grant in the intent). No other data from filesDir goes through here. -->
        <provider
            android:name=".FileProvider"
            android:authorities="com.mygoll.fourform.diagnosticos"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name=".FourFormService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/fourform_service" />
        </service>
    </application>
</manifest>
