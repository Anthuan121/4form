<?xml version="1.0" encoding="utf-8"?>
<!-- typeViewTextChanged: how the app learns by observing the user correct/fill fields.
     typeWindowStateChanged: end of session (Anthuan's decision on 09/09: screen changed = submitted).
     flagRequestAccessibilityButton: the explicit trigger. The service ONLY acts when invoked.
     flagReportViewIds: without it, viewIdResourceName comes back null.
     flagIncludeNotImportantViews: fields inside a WebView often depend on it. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewTextChanged|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagReportViewIds|flagIncludeNotImportantViews|flagRequestAccessibilityButton"
    android:canRetrieveWindowContent="true"
    android:description="@string/descricao_servico"
    android:notificationTimeout="100" />
