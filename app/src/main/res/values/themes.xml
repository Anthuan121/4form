<?xml version="1.0" encoding="utf-8"?>
<!-- ONLY style file in the app (along with colors.xml), on purpose: decision from brief 240,
     visual system delivered by brief 241. Surface choice: SOLID, Material 3
     baseline dark. The numeric comparison that ruled out the translucent option is in
     /root/shared-memory/produto/preenche-decisao-de-superficie.md. -->
<resources>
    <style name="Theme.4Form" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/superficie</item>
        <item name="android:colorBackground">@color/superficie</item>
        <!-- global textColor kept from 240 (proven on the build device); the roles
             below cover hint, cursor, EditText underline, button, and system bars. -->
        <item name="android:textColor">@color/texto</item>
        <item name="android:textColorPrimary">@color/texto</item>
        <item name="android:textColorSecondary">@color/texto_secundario</item>
        <item name="android:textColorHint">@color/texto_secundario</item>
        <item name="android:colorAccent">@color/primaria</item>
        <item name="android:colorControlNormal">@color/contorno</item>
        <item name="android:colorControlActivated">@color/primaria</item>
        <item name="android:colorButtonNormal">@color/superficie_recipiente_alto</item>
        <!-- Font: only Geist in the theme, on purpose. It's the BODY font in the 241
             guideline (Bevan only for titles >= 22sp, Bitcount only for standalone numbers);
             setting Bevan globally would clot every small sentence. The 3 .ttf files ship
             in the repo with LICENSE-fonts-OFL.txt at the root, the only obligation under
             OFL 1.1. Bevan and Bitcount remain available for build day. -->
        <item name="android:fontFamily">@font/geist_variable</item>
        <item name="android:statusBarColor">@color/superficie</item>
        <item name="android:navigationBarColor">@color/superficie</item>
    </style>
</resources>
